# Loopback-only, same as every other internal-only API on this CM5 - no
# real gRPC/WebSocket transport exists yet (see Cargo.toml), so both
# routes still only ever reach RecordingSink/SimulatedTransport, the
# same honest fakes the CLI already uses. This closes the "only
# reachable as a one-shot CLI" gap, not that still-deferred question.
[Unit]
Description=HYDRA-UMC-HIL-BRIDGE real route/mirror-bridging API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-hil-bridge
Group=hydra-umc-hil-bridge
WorkingDirectory=/opt/hydra-umc/hil-bridge
ExecStart=/opt/hydra-umc/hil-bridge/hydra-umc-hil-bridge serve --addr 127.0.0.1 --port 8113
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
