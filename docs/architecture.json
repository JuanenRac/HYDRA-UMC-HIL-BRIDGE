{
  "repo": "HYDRA-UMC-HIL-BRIDGE",
  "ecosystem": "hydra",
  "tagline": "A joint moves only with a fresh, signed interlock certificate from the digital twin.",
  "description": "HYDRA-UMC-HIL-BRIDGE routes a command for a real or a simulated robot. In real mode it accepts the command only with an ed25519 interlock certificate that the digital twin signed a moment ago, checks the joint against the URDF limits and keeps a watchdog that stops the joint when its lease runs out. A local HTTP API, guarded by a Bearer token, and a command line reach the same decision logic.",
  "columns": [
    "WHO COMMANDS IT",
    "THIS REPOSITORY",
    "WHAT IT TALKS TO"
  ],
